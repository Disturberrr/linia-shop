{
  "name": "shop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.5" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "NODE_ENV=production tsx server/src/index.ts",
    "start:dev": "tsx watch server/src/index.ts",
    "migrate": "tsx server/src/migrate.ts",
    "seed": "tsx server/src/seed.ts",
    "create-admin": "tsx server/src/createAdmin.ts",
    "typecheck": "tsc -p server/tsconfig.json --noEmit",
    "test": "tsx --test server/test/*.test.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
